# Copy this file to .env and fill in real values. NEVER commit .env.
# Supabase Postgres connection string (Project Settings -> Database).
# For a server with many connections, prefer the POOLER string (port 6543, "Transaction" mode).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# A long random string you generate (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed web origins for CORS.
CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app

# Port (Render sets this automatically; default 4000 locally).
PORT=4000
