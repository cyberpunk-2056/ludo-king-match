{
  "expo": {
    "name": "Ludo King Maker",
    "slug": "ludora-mobile",
    "version": "1.0.0",
    "scheme": "ludora",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080B13",
    "newArchEnabled": false,
    "android": {
      "package": "com.ludora.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1322"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ludora.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8be0d23-0813-47b3-b92c-6f5c9434f198"
      }
    },
    "owner": "leo_2047"
  }
}
